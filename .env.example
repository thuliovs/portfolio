# Keep authentication enabled while the portfolio is under review.
PORTFOLIO_AUTH_ENABLED=true

# Use a long password and a separate random secret. Configure both in Vercel.
PORTFOLIO_PASSWORD=replace-with-a-strong-review-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Change to true only when the site is approved for public indexing.
PORTFOLIO_PUBLIC=false
